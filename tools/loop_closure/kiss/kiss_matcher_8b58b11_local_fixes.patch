+
+// local fix 5: publish the whole graph (raw keyframe odometry, iSAM2 estimate, every BetweenFactor<Pose3>)
+// as one text message, so the online re-solve node never has to reassemble increments. Format v1 is parsed
+// by tools/loop_closure/online/online_reopt.py; raw poses use the same conversion as raw_poses_tum.txt.
+void PoseGraphManager::publishGraphSnapshot(const gtsam::Values &estimate, bool final_snapshot) {
+  gtsam::NonlinearFactorGraph factors;
+  {
+    std::lock_guard<std::mutex> lock(graph_mutex_);
+    factors = isam_handler_->getFactorsUnsafe();
+  }
+  const size_t n = estimate.size();
+  std::vector<std::pair<double, geometry_msgs::msg::PoseStamped>> raw;
+  raw.reserve(n);
+  {
+    std::lock_guard<std::mutex> lock(keyframes_mutex_);
+    if (keyframes_.size() < n) {
+      RCLCPP_ERROR(this->get_logger(), "local fix 5: %zu keyframes < %zu estimates; snapshot skipped",
+                   keyframes_.size(), n);
+      return;
+    }
+    for (size_t i = 0; i < n; ++i) {
+      raw.emplace_back(keyframes_[i].timestamp_, eigenToPoseStamped(keyframes_[i].pose_, map_frame_));
+    }
+  }
+  std::ostringstream body;
+  body << std::setprecision(17);
+  size_t n_edges = 0;
+  for (const auto &factor : factors) {
+    const auto between = boost::dynamic_pointer_cast<gtsam::BetweenFactor<gtsam::Pose3>>(factor);
+    if (!between || between->key1() >= n || between->key2() >= n) continue;
+    const auto &m = between->measured();
+    const auto q  = m.rotation().toQuaternion();
+    body << "E " << between->key1() << " " << between->key2() << " " << m.x() << " " << m.y() << " "
+         << m.z() << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+    ++n_edges;
+  }
+  const uint64_t seq = ++graph_snapshot_seq_;
+  std::ostringstream out;
+  out << "KISS_GRAPH_SNAPSHOT 1 " << seq << " " << (final_snapshot ? 1 : 0) << " " << n
+      << " " << n_edges << "\n";
+  for (size_t i = 0; i < n; ++i) {
+    const auto &p = raw[i].second.pose;
+    const auto e  = estimate.at<gtsam::Pose3>(i);
+    const auto eq = e.rotation().toQuaternion();
+    out << "K " << i << " " << std::fixed << std::setprecision(9) << raw[i].first << std::defaultfloat
+        << std::setprecision(17) << " " << p.position.x << " " << p.position.y << " " << p.position.z << " "
+        << p.orientation.x << " " << p.orientation.y << " " << p.orientation.z << " " << p.orientation.w
+        << " " << e.x() << " " << e.y() << " " << e.z() << " " << eq.x() << " " << eq.y() << " " << eq.z()
+        << " " << eq.w() << "\n";
+  }
+  std_msgs::msg::String msg;
+  msg.data = out.str() + body.str();
+  graph_snapshot_pub_->publish(msg);
+  RCLCPP_INFO(this->get_logger(), "local fix 5: graph snapshot %lu (%zu keyframes, %zu edges%s)",
+              static_cast<unsigned long>(seq), n, n_edges, final_snapshot ? ", final" : "");
+}
